# PostgreSQL connection string used by Prisma.
#
# Local dev (when running Postgres via `docker compose up -d db`):
#   the docker-compose file exposes Postgres on host port 5433 (to avoid
#   conflicts with any native Postgres already listening on 5432).
#
# Running the full stack inside docker compose (db + app together) uses
# the docker network: postgresql://postgres:postgres@db:5432/job_tracker?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/job_tracker?schema=public"
